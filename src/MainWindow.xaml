<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FTP Flow · 檔案管理器" Width="1280" Height="840" MinWidth="1120" MinHeight="760" Background="#F5F5F7" FontFamily="Segoe UI, Microsoft JhengHei UI" FontSize="13" Foreground="#1D1D1F" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Accent" Color="#007AFF"/>
  <Style TargetType="Button">
   <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#303038"/><Setter Property="BorderBrush" Value="#DFE0E5"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="15,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="38"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.6"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.38"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#007AFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#007AFF"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#007AFF"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#F6F7FA"/><Setter Property="BorderBrush" Value="#E2E3E8"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="11,8"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="InputBorder" CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ScrollViewer x:Name="PART_ContentHost"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="#007AFF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#63636D"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,0,7"/></Style>
  <Style TargetType="ListViewItem"><Setter Property="Padding" Value="8,8"/><Setter Property="Height" Value="46"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Margin" Value="0,1"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E8F2FF"/><Setter Property="Foreground" Value="#005DBA"/></Trigger></Style.Triggers></Style>
  <Style x:Key="TileItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}"><Setter Property="Width" Value="134"/><Setter Property="Height" Value="112"/><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="5"/><Setter Property="HorizontalContentAlignment" Value="Center"/></Style>
  <ItemsPanelTemplate x:Key="TileItemsPanel"><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
  <DataTemplate x:Key="TileItemTemplate"><StackPanel Width="118" HorizontalAlignment="Center" ToolTip="{Binding Name}"><Grid Height="60"><Path Width="45" Height="43" Stretch="Uniform" StrokeThickness="1.3" HorizontalAlignment="Center" VerticalAlignment="Center"><Path.Style><Style TargetType="Path"><Setter Property="Data" Value="M 2,1 L 12,1 L 17,6 L 17,21 L 2,21 Z M 12,1 L 12,6 L 17,6"/><Setter Property="Fill" Value="#F0F6FF"/><Setter Property="Stroke" Value="#6B9BCD"/><Style.Triggers><DataTrigger Binding="{Binding IsDirectory}" Value="True"><Setter Property="Data" Value="M 1,4 L 9,4 L 12,7 L 23,7 L 23,21 L 1,21 Z"/><Setter Property="Fill" Value="#7ABCF8"/><Setter Property="Stroke" Value="#479BE6"/></DataTrigger></Style.Triggers></Style></Path.Style></Path></Grid><TextBlock Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="35"/></StackPanel></DataTemplate>
  <Style TargetType="GridViewColumnHeader"><Setter Property="Background" Value="#FAFAFC"/><Setter Property="Foreground" Value="#7A7A85"/><Setter Property="Padding" Value="12,11"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="FontSize" Value="12"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#ECECF0"/></Style>
 </Window.Resources>
 <Border Background="#F5F5F7"><Grid Margin="24,18,24,18">
  <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
  <Grid>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
    <Border Width="42" Height="42" CornerRadius="13" Background="#007AFF" Margin="0,0,12,0"><Path Data="M 1,4 L 9,4 L 12,7 L 24,7 L 24,22 L 1,22 Z" Stroke="White" StrokeThickness="1.7" Stretch="Uniform" Width="24" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <StackPanel><TextBlock Text="FTP Flow" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="讓每次檔案傳輸，都簡單一點。" FontSize="12" Foreground="#777782" Margin="0,2,0,0"/></StackPanel>
   </StackPanel>
   <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="14" Background="#EAEBF0" Padding="12,6"><TextBlock Text="WINDOWS  /  1.4" FontSize="10" Foreground="#74747E" FontWeight="SemiBold"/></Border>
  </Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="288"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="White" CornerRadius="18" BorderBrush="#E5E5EB" BorderThickness="1" Padding="22">
    <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
      <TextBlock Text="連線設定" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="輸入位置，開始管理遠端檔案。" Foreground="#85858F" FontSize="12" Margin="0,7,0,16"/>
      <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="FTP 帳號" Style="{StaticResource Label}"/><ComboBox x:Name="ProfileBox" Height="40" Padding="8,6" AutomationProperties.Name="選擇 FTP 帳號"/></StackPanel><Button x:Name="ManageProfilesButton" Grid.Column="2" Content="管理" VerticalAlignment="Bottom" Padding="8,6" MinHeight="40" ToolTip="新增、編輯或移除已儲存的 FTP 帳號"/></Grid>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="伺服器" Style="{StaticResource Label}"/><TextBox x:Name="HostBox" AutomationProperties.Name="FTP 伺服器" ToolTip="主機名稱或 IP，不含 ftp://"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="連接埠" Style="{StaticResource Label}"/><TextBox x:Name="PortBox" Text="21" Padding="8,10" AutomationProperties.Name="連接埠"/></StackPanel></Grid>
      <TextBlock Text="帳號" Style="{StaticResource Label}" Margin="0,12,0,7"/><TextBox x:Name="UserBox" AutomationProperties.Name="帳號"/>
      <TextBlock Text="密碼 · 直接顯示，可修改" Style="{StaticResource Label}" Margin="0,12,0,7"/><TextBox x:Name="PassBox" AutomationProperties.Name="密碼，直接顯示"/>
      <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="起始目錄" Style="{StaticResource Label}"/><TextBox x:Name="InitialBox" Text="/simon" AutomationProperties.Name="起始目錄"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="檔名編碼" Style="{StaticResource Label}"/><ComboBox x:Name="EncodingBox" Height="40" Padding="8,6" SelectedIndex="0" AutomationProperties.Name="檔名編碼"><ComboBoxItem Content="UTF-8"/><ComboBoxItem Content="GBK"/><ComboBoxItem Content="Big5"/></ComboBox></StackPanel></Grid>
      <Expander x:Name="AiSettingsExpander" Header="AI 控制 API" Margin="0,18,0,0" Foreground="#303038" FontWeight="SemiBold"><StackPanel Margin="0,12,0,0"><TextBlock Text="本機 API 位址" Style="{StaticResource Label}"/><TextBox x:Name="ApiEndpointBox" IsReadOnly="True" Background="#F0F1F5"/><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="連接埠" Style="{StaticResource Label}"/><TextBox x:Name="ApiPortBox" Text="17821"/></StackPanel><Button x:Name="ApiToggleButton" Grid.Column="2" Content="停止 API" VerticalAlignment="Bottom" Padding="6,6" MinHeight="40"/></Grid><TextBlock x:Name="ApiStatusLabel" Text="API 尚未啟動" Foreground="#85858F" FontSize="11" Margin="0,8,0,0"/><TextBlock Text="AI 存取權杖（本機加密保存）" Style="{StaticResource Label}" Margin="0,12,0,7"/><TextBox x:Name="ApiTokenBox" IsReadOnly="True" ToolTip="此權杖只在本機顯示與保存"/><Button x:Name="ApiCopyButton" Content="複製 API 位址與存取權杖" Margin="0,9,0,0" Padding="10,7" MinHeight="34"/><TextBlock Text="僅允許本機程式連線。可讀取檔案、切換目錄、新增資料夾、上傳、下載與刪除。" Foreground="#85858F" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Expander>
     </StackPanel></ScrollViewer>
     <Button x:Name="ConnectButton" Grid.Row="1" Content="連線到伺服器" Style="{StaticResource Primary}" Margin="0,12,0,0"/>
     <Border Grid.Row="2" Background="#F5F7FB" CornerRadius="12" Padding="12" Margin="0,12,0,0"><StackPanel><Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="ConnectionDot" Width="7" Height="7" Fill="#AEAEB7" Margin="0,0,7,0"/><TextBlock x:Name="ConnectionLabel" Text="尚未連線" FontWeight="SemiBold" FontSize="12"/></StackPanel><Button x:Name="DisconnectButton" Content="中斷" HorizontalAlignment="Right" Padding="8,3" MinHeight="25" FontSize="11" IsEnabled="False" ToolTip="中斷連線"/></Grid><TextBlock x:Name="ConnectionHint" Text="設定將在連線時儲存於本機。" FontSize="11" Foreground="#85858F" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
    </Grid>
   </Border>
   <Border Grid.Column="2" Background="White" CornerRadius="18" BorderBrush="#E5E5EB" BorderThickness="1" Padding="22,20,22,14">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,19"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="我的檔案" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="CountLabel" Text="連線後即可瀏覽資料夾與檔案" FontSize="12" Foreground="#85858F" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"><Button x:Name="ListViewButton" Content="清單" ToolTip="直向詳細清單" Padding="10,5" MinHeight="34" Margin="0,0,5,0"/><Button x:Name="TileViewButton" Content="圖示" ToolTip="橫向圖示排列" Padding="10,5" MinHeight="34"/></StackPanel><TextBox x:Name="SearchBox" Grid.Column="2" Height="38" VerticalAlignment="Center" ToolTip="搜尋目前資料夾，Ctrl+F" AutomationProperties.Name="搜尋目前資料夾"/><TextBlock x:Name="SearchPlaceholder" Grid.Column="2" Text="搜尋檔案名稱…" Foreground="#9999A3" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
     <Grid Grid.Row="1" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="43"/><ColumnDefinition Width="*"/><ColumnDefinition Width="61"/><ColumnDefinition Width="43"/></Grid.ColumnDefinitions>
      <Button x:Name="RootButton" Content="&#xE80F;" FontFamily="Segoe MDL2 Assets" Padding="0" Margin="0,0,7,0" ToolTip="根目錄" AutomationProperties.Name="根目錄"/><Button x:Name="UpButton" Grid.Column="1" Content="&#xE74A;" FontFamily="Segoe MDL2 Assets" Padding="0" Margin="0,0,7,0" ToolTip="上一層 · Alt+↑" AutomationProperties.Name="上一層"/>
      <TextBox x:Name="PathBox" Grid.Column="2" Text="/simon" AutomationProperties.Name="遠端目錄，按 Enter 前往"/><Button x:Name="GoButton" Grid.Column="3" Content="前往" Padding="0" Margin="7,0,0,0"/><Button x:Name="RefreshButton" Grid.Column="4" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" Padding="0" Margin="7,0,0,0" ToolTip="重新整理 · F5" AutomationProperties.Name="重新整理"/>
     </Grid>
     <Grid Grid.Row="2" Margin="0,0,0,15"><StackPanel Orientation="Horizontal"><Button x:Name="NewFolderButton" Content="＋ 新增資料夾" Margin="0,0,8,0"/><Button x:Name="UploadButton" Content="↑ 上傳檔案" Style="{StaticResource Primary}" Margin="0,0,8,0"/><Button x:Name="DownloadButton" Content="↓ 下載選取" Margin="0,0,8,0"/><Button x:Name="DownloadAllButton" Content="全部下載"/></StackPanel><Button x:Name="DeleteButton" Content="刪除" HorizontalAlignment="Right" Foreground="#DC4343" Background="#FFF4F3" BorderBrush="#FFE0DF"/></Grid>
     <Grid Grid.Row="3"><Border CornerRadius="12" BorderBrush="#E9E9EF" BorderThickness="1"><ListView x:Name="FileList" BorderThickness="0" Background="Transparent" SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="遠端檔案列表"><ListView.View><GridView><GridViewColumn Width="320" Header="名稱"><GridViewColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Grid Width="30" VerticalAlignment="Center"><Path Width="18" Height="19" HorizontalAlignment="Left" Stretch="Uniform" StrokeThickness="1.3"><Path.Style><Style TargetType="Path"><Setter Property="Data" Value="M 2,1 L 12,1 L 17,6 L 17,21 L 2,21 Z M 12,1 L 12,6 L 17,6"/><Setter Property="Fill" Value="#F0F6FF"/><Setter Property="Stroke" Value="#6B9BCD"/><Style.Triggers><DataTrigger Binding="{Binding IsDirectory}" Value="True"><Setter Property="Data" Value="M 1,4 L 9,4 L 12,7 L 23,7 L 23,21 L 1,21 Z"/><Setter Property="Fill" Value="#7ABCF8"/><Setter Property="Stroke" Value="#479BE6"/></DataTrigger></Style.Triggers></Style></Path.Style></Path></Grid><TextBlock Text="{Binding Name}" VerticalAlignment="Center" ToolTip="{Binding Name}"/></StackPanel></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn><GridViewColumn Header="大小" Width="90" DisplayMemberBinding="{Binding SizeText}"/><GridViewColumn Header="類型" Width="75" DisplayMemberBinding="{Binding Kind}"/><GridViewColumn Header="修改時間" Width="165" DisplayMemberBinding="{Binding Modified}"/></GridView></ListView.View></ListView></Border>
      <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="20"><Border Background="#F0F5FD" CornerRadius="24" Width="80" Height="80" HorizontalAlignment="Center"><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="#81ADE2" FontSize="35" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="EmptyTitle" Text="你的檔案，準備就緒" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,8"/><TextBlock x:Name="EmptyHint" Text="在左側確認連線資訊，再按「連線到伺服器」。" Foreground="#85858F" TextWrapping="Wrap" TextAlignment="Center"/></StackPanel>
     </Grid>
     <StackPanel Grid.Row="4" Margin="0,13,0,0"><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="TaskLabel" Text="準備好開始" Foreground="#686874" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button x:Name="CancelButton" Grid.Column="1" Content="取消操作" Padding="10,4" MinHeight="26" FontSize="11" Visibility="Collapsed"/></Grid><ProgressBar x:Name="ProgressBar" Height="5" Minimum="0" Maximum="100" Value="0" BorderThickness="0" Foreground="#007AFF" Background="#EFF0F4"/><Grid Margin="0,8,0,0"><TextBlock x:Name="SelectionLabel" Text="可多選檔案 · 雙擊資料夾進入" FontSize="11" Foreground="#9898A2"/><TextBlock x:Name="TransferLabel" HorizontalAlignment="Right" Text="" FontSize="11" Foreground="#85858F"/></Grid></StackPanel>
    </Grid>
   </Border>
  </Grid>
  <Grid Grid.Row="2" VerticalAlignment="Bottom"><TextBlock x:Name="StatusLabel" Text="就緒" FontSize="11" Foreground="#7E7E88" TextTrimming="CharacterEllipsis" Margin="0,0,200,0"/><TextBlock Text="FTP · 被動模式 · 本機應用程式" FontSize="11" Foreground="#9999A3" HorizontalAlignment="Right"/></Grid>
 </Grid></Border>
</Window>
